# MinIO root credentials (POC only — never use in production)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Demo users (created by init container)
MINIO_DEMO_APP_USER=demo-app
MINIO_DEMO_APP_SECRET=demo-app-secret
MINIO_DEMO_ADMIN_USER=demo-admin
MINIO_DEMO_ADMIN_SECRET=demo-admin-secret

# Storage
MINIO_BUCKET=dobox-dev-bucket

# Internal endpoint (service-to-service inside Docker network)
MINIO_ENDPOINT=http://minio:9000

# Public URL — must match what clients use (nginx simulates Ingress)
# EKS later: https://minio.hubplatform.com.sa
MINIO_PUBLIC_URL=http://localhost

# Spring Boot demo API
DEMO_API_PORT=8080

# Host ports (9000 often taken on Windows — use 9010 for API instead)
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9001
